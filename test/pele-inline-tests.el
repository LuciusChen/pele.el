;;; pele-inline-tests.el --- Inline preview GUI regressions -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: MIT
;; Run in a separate graphical Emacs -Q, with -L . -L test:
;;   -l pele-inline-tests --eval '(ert-run-tests-interactively "pele-inline-")'
(require 'ert)
(require 'pele)
(require 'pele-markdown)
(require 'org)
(require 'image-mode)

(defvar pele-inline-test--width 1200)
(defvar pele-inline-test--height 3600)
(defvar pele-inline-test--renders 0)

(defun pele-inline-test--render (_source callback &optional _options)
  "Supply a known image so tests exercise display and editing, not layout."
  (cl-incf pele-inline-test--renders)
  (funcall callback
           (list :ok t :width pele-inline-test--width :height pele-inline-test--height
                 :svg (format "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"%d\" height=\"%d\"><rect width=\"100%%\" height=\"100%%\" fill=\"#476779\"/></svg>"
                              pele-inline-test--width pele-inline-test--height)))
  nil)

(defmacro pele-inline-test--buffer (mode tail &rest body)
  "Run BODY in MODE with a rendered block followed by TAIL."
  (declare (indent 2))
  `(progn
     (skip-unless (display-graphic-p))
     (save-window-excursion
       (with-temp-buffer
         (funcall ,mode)
         (switch-to-buffer (current-buffer))
         (insert (if (derived-mode-p 'org-mode)
                     "* Heading\n#+begin_src mermaid\ninfo\n#+end_src"
                   "# Heading\n```mermaid\ninfo\n```") ,tail)
         (let ((pele-inline-test--source (current-buffer))
               (pele-inline-test--renders 0)
               (scroll-preserve-screen-position 'always))
           (cl-letf (((symbol-function 'pele-render-async) #'pele-inline-test--render))
             (unwind-protect
                 (progn
                   (if (derived-mode-p 'org-mode) (pele-org-mode 1)
                     (pele-markdown-mode 1))
                   (redisplay t)
                   ,@body)
               (with-current-buffer pele-inline-test--source (pele--inline-disable)))))))))

(defun pele-inline-test--key (key &optional prefix)
  "Run KEY through command hooks and keymaps, then update the display."
  (setq this-command (key-binding (kbd key)))
  (setq last-command-event (aref (kbd key) 0))
  (let ((current-prefix-arg prefix) (real-this-command this-command))
    (run-hooks 'pre-command-hook)
    (call-interactively this-command)
    (run-hooks 'post-command-hook))
  (setq last-command this-command)
  (redisplay t))

(defun pele-inline-test--source-end ()
  "Put point on the closing line, just before the preview."
  (goto-char (point-max))
  (re-search-backward "^\\(?:#\\+end_src\\|```\\)$")
  (beginning-of-line)
  (setq last-command nil))

(defun pele-inline-test--visible-range ()
  "Return the image pixel range currently visible in the window."
  (let ((minimum most-positive-fixnum) (maximum -1))
    (cl-loop for y from 0 below (window-body-height nil t)
             for position = (posn-at-x-y 8 y)
             when (and position (posn-image position))
             do (let ((image-y (cdr (posn-object-x-y position))))
                  (setq minimum (min minimum image-y) maximum (max maximum image-y))))
    (cons minimum maximum)))

(defun pele-inline-test--org-images ()
  "Return Org image overlays in buffer order, including suppressed ones."
  (let ((lists (overlay-lists)))
    (sort (seq-filter (lambda (overlay) (overlay-get overlay 'org-image-overlay))
                      (append (car lists) (cdr lists)))
          (lambda (a b) (< (overlay-start a) (overlay-start b))))))

(ert-deftest pele-inline-org-results-display-only ()
  (let ((file (make-temp-file "pele-result-" nil ".svg")))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"80\" height=\"40\"><rect width=\"80\" height=\"40\"/></svg>"))
          (pele-inline-test--buffer #'org-mode
              (format "\n\n#+RESULTS:\n[[file:%s]]\n\n[[file:%s]]\n\n#+begin_src python\nprint(1)\n#+end_src\n\n#+RESULTS:\n[[file:%s]]\n" file file file)
            (pele-org-mode -1)
            (org-display-inline-images)
            (should (= 3 (length (pele-inline-test--org-images))))
            (buffer-enable-undo)
            (setq buffer-undo-list nil)
            (set-buffer-modified-p nil)
            (let* ((original (buffer-substring-no-properties (point-min) (point-max)))
                   (images (pele-inline-test--org-images))
                   (result (car images))
                   (properties (mapcar (lambda (property)
                                         (cons property (overlay-get result property)))
                                       '(display before-string face keymap)))
                   (other (overlay-get (cadr images) 'display)))
              ;; Images already present when the minor mode starts are suppressed.
              (pele-org-mode 1)
              (should-not (overlay-get result 'display))
              (should (overlay-get result 'pele-org-image))
              (should-not (overlay-get result 'keymap))
              (should (eq other (overlay-get (cadr images) 'display)))
              (should (overlay-get (caddr images) 'display))
              (pele-org-mode -1)
              (dolist (entry properties)
                (should (equal (cdr entry) (overlay-get result (car entry)))))
              (should-not (overlay-get result 'pele-org-image))
              ;; Refreshing through Org does not bring duplicate images back.
              (pele-org-mode 1)
              (org-display-inline-images nil t)
              (setq images (pele-inline-test--org-images))
              (should (= 3 (length images)))
              (should-not (overlay-get (car images) 'display))
              (should (overlay-get (cadr images) 'display))
              (should (overlay-get (caddr images) 'display))
              (should (equal original (buffer-substring-no-properties (point-min) (point-max))))
              (should-not (buffer-modified-p))
              (should-not buffer-undo-list)
              ;; If Org removes an image, disabling Pele must not resurrect it.
              (org-remove-inline-images)
              (pele-org-mode -1)
              (should-not (pele-inline-test--org-images)))))
      (delete-file file))))

(ert-deftest pele-inline-org-named-results-and-queued-images ()
  (let ((file (make-temp-file "pele-named-result-" nil ".svg")))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"80\" height=\"40\"/>"))
          (pele-inline-test--buffer #'org-mode
              (format "\n\n[[file:%s]]\n\n[[file:%s]]\n\n* Elsewhere\n#+RESULTS: diagram\n[[file:%s]]\n" file file file)
            (goto-char (point-min))
            (search-forward "#+begin_src")
            (beginning-of-line)
            (insert "#+name: diagram\n")
            (pele--inline-refresh)
            (if (fboundp 'org-link-preview-region)
                (let ((org-link-preview-batch-size 1))
                  (org-link-preview-region)
                  ;; Later batches run in the Org buffer, even if another is current.
                  (let ((buffer (current-buffer)))
                    (with-temp-buffer
                      (while (buffer-local-value 'org-link-preview--queue buffer)
                        (org-link-preview--process-queue buffer)))))
              (org-display-inline-images))
            (let ((images (pele-inline-test--org-images)))
              (should (= 3 (length images)))
              (should (overlay-get (car images) 'display))
              (should (overlay-get (cadr images) 'display))
              (should-not (overlay-get (caddr images) 'display))
              ;; A result ceases to belong to Pele if the source language changes.
              (goto-char (point-min))
              (search-forward "mermaid")
              (replace-match "text")
              (pele--inline-refresh)
              (should (overlay-get (caddr images) 'display))
              (should-not (overlay-get (caddr images) 'pele-org-image)))))
      (delete-file file))))

(ert-deftest pele-inline-org-babel-keeps-live-preview-and-saved-result ()
  (require 'ob-pele)
  (let ((file (make-temp-file "pele-execute-result-" nil ".svg"))
        (org-confirm-babel-evaluate nil)
        (org-babel-after-execute-hook '(org-display-inline-images)))
    (unwind-protect
        (pele-inline-test--buffer #'org-mode "\n"
          (goto-char (point-min))
          (search-forward "mermaid")
          (replace-match "pele")
          (pele--inline-refresh)
          (let* ((preview (car pele--inline-overlays))
                 (saved-svg (plist-get (overlay-get preview 'pele-result) :svg)))
            (cl-letf (((symbol-function 'pele-render)
                       (lambda (&rest _) (list :ok t :svg saved-svg))))
              (goto-char (point-min))
              (forward-line 1)
              (org-babel-execute-src-block nil nil `((:file . ,file))))
            (pele--inline-refresh)
            (should (eq preview (car pele--inline-overlays)))
            (should (= 1 (length (pele-inline-test--org-images))))
            (should-not (overlay-get (car (pele-inline-test--org-images)) 'display))
            (should (string-search (concat "[[file:" file "]]") (buffer-string)))
            (let ((renders pele-inline-test--renders))
              (goto-char (point-min))
              (search-forward "info")
              (replace-match "flowchart LR\nA --> B")
              (pele--inline-refresh)
              (should (> pele-inline-test--renders renders)))
            (with-temp-buffer
              (insert-file-contents file)
              (should (equal saved-svg (buffer-string))))
            (pele-org-mode -1)
            (should (overlay-get (car (pele-inline-test--org-images)) 'display))))
      (delete-file file))))

(ert-deftest pele-inline-keyboard-focus-at-eof ()
  (dolist (tail '("\n" ""))
    (pele-inline-test--buffer #'org-mode tail
      (let* ((overlay (car pele--inline-overlays))
             (original (buffer-string))
             (image-height (cdr (image-size (overlay-get overlay 'pele-image) t))))
        (pele-inline-test--source-end)
        (pele-inline-test--key "<down>")
        (ert-info ((format "Entering EOF preview, tail=%S" tail))
          (should (eq overlay pele--inline-focus)))
        (should (eq (key-binding (kbd "RET")) #'pele-inline-open))
        (let ((range (pele-inline-test--visible-range)))
          (should (<= (car range) 1))
          (should (>= (cdr range) (- image-height 2))))
        (pele-inline-test--key "<down>")
        (should-not pele--inline-focus)
        (should (= (point) (point-max)))
        (should-error (pele-inline-test--key "<down>") :type 'end-of-buffer)
        (should-not pele--inline-focus)
        (should-not (eq (key-binding (kbd "RET")) #'pele-inline-open))
        (pele-inline-test--key "RET")
        (should (equal (concat original "\n") (buffer-string)))
        (pele--inline-refresh)
        (should (= (overlay-start overlay)
                   (+ (length original) (if (string-suffix-p "\n" original) 1 2))))
        (pele-inline-test--key "<up>")
        ;; Return first to a real blank line the user inserted below the image.
        (when (string-suffix-p "\n" original)
          (should-not pele--inline-focus)
          (should (= (point) (overlay-start overlay)))
          (pele-inline-test--key "<up>"))
        (ert-info ((format "Returning to EOF preview after insertion, tail=%S" tail))
          (should (eq overlay pele--inline-focus)))
        (pele-inline-test--key "<up>")
        (should-not pele--inline-focus)
        (should (looking-back "end_src" (line-beginning-position)))
        (pele-inline-test--key "<up>")
        (should-not pele--inline-focus)
        (should (equal "info" (buffer-substring-no-properties
                               (line-beginning-position) (line-end-position))))))))

(ert-deftest pele-inline-keyboard-crosses-preview-and-returns ()
  (pele-inline-test--buffer #'org-mode "\nFirst paragraph\nSecond paragraph\n"
    (let ((overlay (car pele--inline-overlays)))
      (pele-inline-test--source-end)
      (pele-inline-test--key "<down>")
      (should (eq overlay pele--inline-focus))
      (pele-inline-test--key "<down>")
      (should (looking-at "First paragraph"))
      (pele-inline-test--key "<down>")
      (should (looking-at "Second paragraph"))
      (pele-inline-test--key "<up>")
      (pele-inline-test--key "<up>")
      (should (eq overlay pele--inline-focus))
      (pele-inline-test--key "<up>")
      (should-not pele--inline-focus)
      (should (looking-back "end_src" (line-beginning-position))))))

(ert-deftest pele-inline-return-opens-native-image-viewer ()
  (pele-inline-test--buffer #'org-mode "\n"
    (let ((source-buffer (current-buffer)) (original (buffer-string)))
      (pele-inline-test--source-end)
      (pele-inline-test--key "<down>")
      (pele-inline-test--key "RET")
      (should (derived-mode-p 'image-mode))
      (should buffer-read-only)
      (should-not buffer-file-name)
      (should (equal (cons pele-inline-test--width pele-inline-test--height)
                     (image-size (image-get-display-property) t)))
      (pele-inline-test--key "<down>")
      (should (> (window-vscroll nil t) 0))
      (pele-inline-test--key "<right>")
      (should (> (window-hscroll) 0))
      (pele-inline-test--key "q")
      (should (eq source-buffer (current-buffer)))
      (should (equal original (buffer-string)))
      (should-not pele--inline-focus))))

(ert-deftest pele-inline-size-fits-both-dimensions-and-small-images-stay-small ()
  (dolist (dimensions '((4000 . 400) (400 . 4000) (40 . 40)))
    (let ((pele-inline-test--width (car dimensions))
          (pele-inline-test--height (cdr dimensions)))
      (pele-inline-test--buffer #'org-mode "\n"
        (let ((size (image-size (overlay-get (car pele--inline-overlays) 'pele-image) t)))
          (should (<= (car size) (min (car dimensions) (pele--window-width))))
          (should (<= (cdr size) (min (cdr dimensions) (pele--window-height)))))))))

(ert-deftest pele-inline-height-resize-does-not-render-again ()
  (pele-inline-test--buffer #'org-mode "\n"
    (let* ((overlay (car pele--inline-overlays))
           (initial (image-size (overlay-get overlay 'pele-image) t))
           (height (frame-height)))
      (unwind-protect
          (progn
            (set-frame-height nil 20)
            (redisplay t)
            (pele--inline-refresh)
            (should (< (cdr (image-size (overlay-get overlay 'pele-image) t)) (cdr initial)))
            (should (= 1 pele-inline-test--renders)))
        (set-frame-height nil height)))))

(ert-deftest pele-inline-layout-notification-keeps-image-focus ()
  (pele-inline-test--buffer #'org-mode "\n"
    (pele-inline-test--source-end)
    (pele-inline-test--key "<down>")
    (let ((overlay pele--inline-focus))
      (pele--inline-schedule)
      (should (eq overlay pele--inline-focus))
      (pele--inline-refresh)
      (should (eq overlay pele--inline-focus)))))

(ert-deftest pele-inline-shared-buffer-fits-the-smaller-window ()
  (pele-inline-test--buffer #'org-mode "\n"
    (let ((other (split-window-right 25)))
      (set-window-buffer other (current-buffer))
      (pele--inline-refresh)
      (let ((size (image-size (overlay-get (car pele--inline-overlays) 'pele-image) t)))
        (dolist (window (get-buffer-window-list nil nil t))
          (should (< (car size) (window-body-width window t)))
          (should (< (cdr size) (window-body-height window t))))))))

(ert-deftest pele-inline-typing-leaves-preview-and-inserts-below-it ()
  (pele-inline-test--buffer #'org-mode "\n"
    (let ((original (buffer-string)))
      (pele-inline-test--source-end)
      (pele-inline-test--key "<down>")
      (should pele--inline-focus)
      (pele-inline-test--key "a")
      (should-not pele--inline-focus)
      (should (equal (concat original "a") (buffer-string))))))

(ert-deftest pele-inline-display-and-focus-preserve-save-and-undo ()
  (pele-inline-test--buffer #'org-mode "\n"
    (let ((original (buffer-string))
          (file (make-temp-file "pele-inline-" nil ".org")))
      (buffer-enable-undo)
      (setq buffer-undo-list nil)
      (set-buffer-modified-p nil)
      (pele-inline-test--source-end)
      (pele-inline-test--key "<down>")
      (pele-inline-test--key "<down>")
      (should-not (buffer-modified-p))
      (should-not buffer-undo-list)
      (undo-boundary)
      (pele-inline-test--key "RET")
      (undo-boundary)
      (pele--inline-refresh)
      (setq last-command 'self-insert-command)
      (undo-only 1)
      (should (equal original (buffer-string)))
      (unwind-protect
          (let ((buffer-file-name file) (make-backup-files nil))
            (set-buffer-modified-p t)
            (save-buffer)
            (should (equal original (with-temp-buffer (insert-file-contents file) (buffer-string)))))
        (delete-file file)))))

(ert-deftest pele-inline-markdown-keyboard-navigation ()
  (let ((modes (seq-filter
                (lambda (mode)
                  (and (require mode nil t)
                       (or (eq mode 'markdown-mode)
                           (treesit-ready-p '(markdown markdown-inline) t))))
                '(markdown-mode markdown-ts-mode))))
    (skip-unless modes)
    (dolist (mode modes)
      (pele-inline-test--buffer mode "\nParagraph\n"
        (pele-inline-test--source-end)
        (pele-inline-test--key "<down>")
        (should pele--inline-focus)
        (pele-inline-test--key "<down>")
        (should (looking-at "Paragraph"))
        (pele-inline-test--key "<up>")
        (should pele--inline-focus)
        (pele-inline-test--key "<up>")
        (should-not pele--inline-focus)
        (should (looking-back "```" (line-beginning-position)))))))

(ert-deftest pele-inline-programmatic-motion-and-mx-dispatch ()
  (pele-inline-test--buffer #'org-mode "\n"
    (let ((real-this-command nil) (this-command nil) (current-prefix-arg nil))
      (pele-inline-test--source-end)
      (funcall-interactively #'next-line 1 t)
      (should-not pele--inline-focus)
      (when (require 'meow nil t)
        (pele-inline-test--source-end)
        (meow-next nil)
        (should-not pele--inline-focus))
      (when (require 'evil nil t)
        (pele-inline-test--source-end)
        (evil-next-line 1)
        (should-not pele--inline-focus)))
    (pele-inline-test--source-end)
    (let ((this-command 'execute-extended-command)
          (real-this-command 'execute-extended-command)
          (suggest-key-bindings nil))
      (funcall-interactively #'execute-extended-command nil "next-line"))
    (should pele--inline-focus)))

(ert-deftest pele-inline-wheel-burst-terminates-at-eof ()
  (require 'mwheel)
  (pele-inline-test--buffer #'org-mode "\n"
    (pele-inline-test--source-end)
    (let* ((calls 0)
           (native (symbol-function 'scroll-up))
           (mouse-wheel-scroll-amount '(20))
           (mouse-wheel-progressive-speed nil))
      (cl-letf (((symbol-function 'scroll-up)
            (lambda (&rest args)
              ;; Stop a regression in mwheel's retry loop without hanging ERT.
              (cl-incf calls)
              (when (> calls 10) (error "Native wheel scrolling did not terminate"))
              (apply native args))))
        (mwheel-scroll (list 'wheel-down (posn-at-x-y 8 100))))
      (redisplay t)
      (let* ((image (overlay-get (car pele--inline-overlays) 'pele-image))
             (range (pele-inline-test--visible-range)))
        (ert-info ((format "calls=%d start=%d point=%d end=%d vscroll=%S body=%S size=%S below=%S"
                           calls (window-start) (point) (point-max) (window-vscroll nil t)
                           (window-body-height nil t) (image-size image t)
                           (eq pele--inline-below (car pele--inline-overlays))))
          (should (<= (car range) 1))
          (should (>= (cdr range) (- (cdr (image-size image t)) 2))))))))

(ert-deftest pele-inline-disabling-restores-custom-wheel-handler ()
  (pele-inline-test--buffer #'org-mode "\n"
    (pele-org-mode -1)
    (should-not (local-variable-p 'mwheel-scroll-up-function))
    (setq-local mwheel-scroll-up-function #'ignore)
    (pele-org-mode 1)
    (should (eq mwheel-scroll-up-function #'pele--inline-scroll-up))
    (pele-org-mode -1)
    (should (local-variable-p 'mwheel-scroll-up-function))
    (should (eq mwheel-scroll-up-function #'ignore))))

(defun pele-inline-test--keys (keys)
  "Run a real command sequence, including modal state and operator hooks."
  (execute-kbd-macro (kbd keys))
  (redisplay t))

(defun pele-inline-test--modal-navigation (down up)
  "Check preview focus and the image viewer using DOWN and UP commands."
  (let ((original (buffer-string)) (overlay (car pele--inline-overlays)))
    (pele-inline-test--source-end)
    (pele-inline-test--keys down)
    (should (eq overlay pele--inline-focus))
    (should (= (point) (overlay-start overlay)))
    (pele-inline-test--keys down)
    (should-not pele--inline-focus)
    (should (= (point) (overlay-start overlay)))
    (pele-inline-test--keys up)
    (should (eq overlay pele--inline-focus))
    (pele-inline-test--keys up)
    (should-not pele--inline-focus)
    (pele-inline-test--keys up)
    (should-not pele--inline-focus)
    (should (equal "info" (buffer-substring-no-properties
                           (line-beginning-position) (line-end-position))))
    (pele-inline-test--source-end)
    (pele-inline-test--keys (concat down " RET"))
    (should (derived-mode-p 'image-mode))
    (should (eq (key-binding (kbd "q")) #'quit-window))
    (pele-inline-test--keys "q")
    (should (equal original (buffer-string)))))

(ert-deftest pele-inline-meow-navigation-and-viewer ()
  (skip-unless (require 'meow nil t))
  (meow-normal-define-key '("j" . meow-next) '("k" . meow-prev) '("J" . meow-next-expand))
  (meow-motion-define-key '("j" . meow-next) '("k" . meow-prev))
  (dolist (tail '("\n" "" "\nParagraph\nTail\n"))
    (pele-inline-test--buffer #'org-mode tail
      (unwind-protect
          (progn
            (meow-global-mode 1)
            (ert-info ((format "Meow, tail=%S" tail))
              (pele-inline-test--modal-navigation "j" "k"))
            (let ((overlay (car pele--inline-overlays)))
              (meow-normal-define-key '("n" . meow-next) '("p" . meow-prev))
              (pele-inline-test--source-end)
              (pele-inline-test--keys "n")
              (should (eq overlay pele--inline-focus))
              (pele-inline-test--keys "p")
              (should-not pele--inline-focus)))
        (meow-global-mode -1)))))

(ert-deftest pele-inline-meow-counts-and-selection-stay-native ()
