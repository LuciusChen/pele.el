  (dolist (tail '("\n" "" "\nParagraph\nTail\n"))
    (pele-inline-test--buffer #'org-mode tail
      (unwind-protect
          (progn
            (evil-mode 1)
            (evil-normal-state)
            (ert-info ((format "Evil, tail=%S" tail))
              (pele-inline-test--modal-navigation "j" "k"))
            (let ((overlay (car pele--inline-overlays)))
              (pele-inline-test--source-end)
              (pele-inline-test--keys "g j")
              (should (eq overlay pele--inline-focus))
              (pele-inline-test--keys "g k")
              (should-not pele--inline-focus)))
        (evil-mode -1)))))

(ert-deftest pele-inline-evil-count-selection-and-operator-stay-native ()
  (skip-unless (require 'evil nil t))
  (let (control)
    (dolist (previews '(nil t))
      (pele-inline-test--buffer #'org-mode "\nParagraph\nTail\n"
        (unless previews (pele-org-mode -1))
        (unwind-protect
            (progn
              (evil-local-mode 1)
              (evil-normal-state)
              (goto-char (point-min))
              (pele-inline-test--keys "3 j")
              (should (= (line-number-at-pos) 4))
              (should-not pele--inline-focus)
              (pele-inline-test--source-end)
              (pele-inline-test--keys "v j")
              (should (evil-visual-state-p))
              (should-not pele--inline-focus)
              (pele-inline-test--keys "<escape>")
              (goto-char (point-min))
              (let ((select-enable-clipboard nil) (select-enable-primary nil)
                    (interprogram-cut-function nil) (interprogram-paste-function nil))
                (pele-inline-test--keys "d j"))
              (if previews (should (equal control (buffer-string)))
                (setq control (buffer-string))))
          (evil-local-mode -1))))))

